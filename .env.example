# Optional for local Node when Deno.openKv is unavailable (vp run dev).
# On Deno Deploy, omit this — Deno.openKv() auto-connects to the linked database.
# DENO_KV_URL=https://api.deno.com/v2/databases/<id>/connect

# Cookie session signing secret (required in production)
# SESSION_SECRET=generate-with-openssl-rand-hex-32

# WebAuthn relying party settings
# Local: WEBAUTHN_RP_ID=localhost
# Prod + PR previews on *.jlarky.deno.net: WEBAUTHN_RP_ID=jlarky.deno.net
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=llm-usage
# Optional extra origins (request Origin is also accepted for localhost and *.jlarky.deno.net)
# WEBAUTHN_ORIGIN=http://localhost:4576
