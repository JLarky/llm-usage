# Optional for local dev when Deno.openKv is unavailable (vp run dev on Node).
# On Deno Deploy, omit this — Deno.openKv() auto-connects to the linked database.
# DENO_KV_URL=https://api.deno.com/v2/databases/<id>/connect

# Required bearer token for POST /api/usage
USAGE_API_TOKEN=generate-with-openssl-rand-hex-32
